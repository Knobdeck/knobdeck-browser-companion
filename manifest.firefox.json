{
  "manifest_version": 2,
  "name": "KnobDeck Browser Companion",
  "short_name": "KnobDeck",
  "version": "1.0.0",
  "description": "Lets the KnobDeck dial and deck control this browser: tabs, windows, zoom, bookmarks and history, without keyboard shortcuts.",
  "homepage_url": "https://knobdeck.harshalkudale.com",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "scripts": ["background.js"], "persistent": true },
  "permissions": ["tabs", "bookmarks", "history", "sessions", "storage", "<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-companion@knobdeck.harshalkudale.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
