{
  "manifest_version": 3,
  "name": "KnobDeck Browser Companion",
  "short_name": "KnobDeck",
  "version": "1.0.0",
  "description": "Lets the KnobDeck dial and deck control this browser: tabs, windows, zoom, bookmarks and history, without keyboard shortcuts.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://knobdeck.harshalkudale.com",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "bookmarks", "history", "sessions", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
